{
	"info": {
		"_postman_id": "8f28b2a1-e408-4e89-a2bf-a720dc274941",
		"name": "Absensi Digital - Golang REST API & ESP32 (Lengkap 2026)",
		"description": "Koleksi Postman REST API Resmi untuk Sistem Presensi Digital Pondok Pesantren & Sekolah (IoT ESP32 + Golang + SQLite).\n\n🌟 Fitur & Modul API:\n1. Autentikasi JWT Admin.\n2. Integrasi IoT ESP32 (RFID + Sensor Sidik Jari R503, Sync Booting, Upload Template .bin, Offline Batch Flush).\n3. Manajemen Sidik Jari (Daftar Slot, Mapping Anggota, Hapus Remote dengan instruksi restart sensor).\n4. Data Master Anggota (Santri / Guru, Bulk Import Excel).\n5. Data Master Kelas & Jabatan.\n6. Laporan & Rekapitulasi Presensi (Harian, Bulanan, Summary).\n7. Pengaturan Sistem, Logo Instansi, Batas Jam, dan Reset Database.\n8. Server-Sent Events (SSE) Realtime Stream & Health Check.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autentikasi",
			"item": [
				{
					"name": "Login Administrator",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (pm.response.code === 200 && jsonData.token) {",
									"    pm.collectionVariables.set(\"jwt_token\", jsonData.token);",
									"    console.log(\"JWT Token berhasil disimpan ke variabel: \", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"login"
							]
						},
						"description": "Endpoint login untuk administrator. Token JWT akan otomatis tersimpan ke variabel {{jwt_token}} dan digunakan oleh request lain di koleksi ini."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Integrasi Mesin ESP32 (IoT Actions)",
			"description": "Endpoint publik yang digunakan oleh mikrokontroler ESP32 untuk presensi RFID, sidik jari, sinkronisasi booting, upload template, dan flush log offline.",
			"item": [
				{
					"name": "1. Tap Absensi Sidik Jari (Fingerprint Scan)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "KUNCI_API_PRESENSI_V1_2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"device_id\": \"PRESENSI-V1\",\n    \"fingerprint_id\": 1,\n    \"tipe_scan\": \"auto\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendance/tap",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"tap"
							]
						},
						"description": "Simulasi scan jari pada sensor R503. Backend otomatis mendeteksi apakah santri/guru tersebut masuk atau pulang dan mengecek batas jeda 2 menit untuk mencegah dobel absen."
					},
					"response": []
				},
				{
					"name": "2. Tap Absensi RFID (Card Scan)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "KUNCI_API_PRESENSI_V1_2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"device_id\": \"PRESENSI-V1\",\n    \"rfid_tag\": \"0104830615\",\n    \"tipe_scan\": \"auto\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendance/tap",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"tap"
							]
						},
						"description": "Simulasi tap kartu RFID pada reader RC522. Backend mencatat riwayat kehadiran atau auto-register jika kartu belum terdaftar."
					},
					"response": []
				},
				{
					"name": "3. Booting Sync & Sensor Purge (Action: sync)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "KUNCI_API_PRESENSI_V1_2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"sync\",\n    \"device_id\": \"PRESENSI-V1\",\n    \"active_fingerprints\": [1, 2, 3, 4, 5],\n    \"total_fingerprints\": 5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendance/tap",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"tap"
							]
						},
						"description": "Dipanggil saat ESP32 pertama kali booting. Server mencatat seluruh slot aktif dan merespon dengan daftar 'delete_fingerprints' jika ada slot yang telah dihapus admin melalui web."
					},
					"response": []
				},
				{
					"name": "4. Upload Seluruh Template Sidik Jari (Action: upload_templates)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "KUNCI_API_PRESENSI_V1_2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"upload_templates\",\n    \"device_id\": \"PRESENSI-V1\",\n    \"templates\": [\n        {\n            \"fingerprint_id\": 1,\n            \"template_data\": \"010203040506070809...\"\n        },\n        {\n            \"fingerprint_id\": 2,\n            \"template_data\": \"010203040506070809...\"\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendance/tap",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"tap"
							]
						},
						"description": "Dipanggil otomatis oleh ESP32 setelah selesai merestore file backup .bin agar server database memiliki salinan seluruh template sidik jari."
					},
					"response": []
				},
				{
					"name": "5. Batch Flush Antrean Presensi Offline (Action: offline_sync)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-KEY",
								"value": "KUNCI_API_PRESENSI_V1_2026"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"offline_sync\",\n    \"device_id\": \"PRESENSI-V1\",\n    \"logs\": [\n        \"{\\\"fingerprint_id\\\": 1, \\\"rfid_tag\\\": \\\"\\\", \\\"recorded_at\\\": \\\"2026-09-03 06:45:10\\\"}\",\n        \"{\\\"fingerprint_id\\\": 0, \\\"rfid_tag\\\": \\\"0104830615\\\", \\\"recorded_at\\\": \\\"2026-09-03 06:46:20\\\"}\"\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendance/tap",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"attendance",
								"tap"
							]
						},
						"description": "Mengirimkan seluruh data antrean presensi yang disimpan di flash SPIFFS ESP32 saat jaringan WiFi sempat terputus."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Manajemen Sidik Jari (Fingerprints)",
			"item": [
				{
					"name": "Get Semua Slot Sidik Jari & Relasi Anggota",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/fingerprints",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fingerprints"
							]
						},
						"description": "Mengambil seluruh slot sidik jari yang terdaftar di database server beserta status mapping (mapped/unmapped) dan data santri/guru terkait."
					},
					"response": []
				},
				{
					"name": "Hubungkan (Map) Sidik Jari ke Anggota",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fingerprint_id\": 1,\n    \"member_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fingerprints/map",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fingerprints",
								"map"
							]
						},
						"description": "Menghubungkan slot sensor sidik jari tertentu ke profil santri atau guru di database."
					},
					"response": []
				},
				{
					"name": "Lepas Hubungan (Unmap) Sidik Jari",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fingerprint_id\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/fingerprints/unmap",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fingerprints",
								"unmap"
							]
						},
						"description": "Melepaskan kaitan slot sidik jari sehingga menjadi 'unmapped' tanpa menghapus model sidik jarinya."
					},
					"response": []
				},
				{
					"name": "Hapus Sidik Jari dari Server & Antrean Sensor ESP32",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"url": {
							"raw": "{{baseUrl}}/api/fingerprints?id=1&fingerprint_id=1&device_id=PRESENSI-V1",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"fingerprints"
							],
							"query": [
								{
									"key": "id",
									"value": "1"
								},
								{
									"key": "fingerprint_id",
									"value": "1"
								},
								{
									"key": "device_id",
									"value": "PRESENSI-V1"
								}
							]
						},
						"description": "Menghapus data sidik jari dari database server dan memasukkannya ke antrean penghapusan fisik sensor R503 saat ESP32 dinyalakan ulang (restart)."
					},
					"response": []
				}
			]
		},
